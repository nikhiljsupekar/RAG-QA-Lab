# Copy to .env (never commit .env). Every value is optional - the app runs without any of them.

# Claude is OPTIONAL. Leave blank to use retrieval-only (extractive) mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# auto = try Sentence Transformers, fall back to the offline lexical embedder
# sentence-transformers | hashing | auto
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# 1 = sidebar can index files by typing a local path (fallback for blocked file dialogs).
# Set to 0 for any shared/hosted deployment, because it reads files from the server's disk.
ALLOW_LOCAL_PATHS=1

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
